# Copy to .env and fill in. NEVER commit .env
PORT=3000

# Supabase: Project Settings > Database > Connection string (use "Session pooler" URI)
# Neon: Dashboard > Connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_SSL=true

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Where reset-password.html is served from (used in reset emails)
FRONTEND_URL=http://localhost:3000
# Only if the frontend is on a different domain, e.g. GitHub Pages
CORS_ORIGINS=https://build-exe.github.io

# Email (mailer.js)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
MAIL_FROM="Goal2Govt <you@example.com>"
